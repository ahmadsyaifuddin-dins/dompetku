FONNTE_TOKEN=your_fonnte_token_here
WA_PENGEMBANG=628xxxxxxxxxxx

# Proxy CORS untuk versi web (opsional).
# Kosongkan untuk nonaktifkan (Android/iOS tidak butuh proxy).
# Contoh pakai servis umum:
#   FONNTE_PROXY_URL=https://corsproxy.io/?
# Contoh pakai worker sendiri (recommended untuk produksi):
#   FONNTE_PROXY_URL=https://wa-proxy-mu.workers.dev
# Lihat tool/worker_cors_proxy.js untuk script Cloudflare Worker.
FONNTE_PROXY_URL=
